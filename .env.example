# =====================================================================
# Configuración del entorno. Copiar como ".env" (en la raíz del proyecto,
# junto a este archivo) y completar. El .env NUNCA se sube al repositorio.
# Las variables definidas en Apache (SetEnv) tienen prioridad sobre este
# archivo.
# =====================================================================

# local = muestra errores en pantalla. En el servidor: production.
APP_ENV=production
APP_TIMEZONE=America/Bogota

# 1 solo si hay un balanceador o CloudFront delante que termina HTTPS.
APP_TRUST_PROXY=0

# --- Base de datos: Supabase (PostgreSQL) ----------------------------
# Supabase → Connect → "Session pooler" (IPv4; NO usar el "Transaction
# pooler" del puerto 6543: no admite las sentencias preparadas de PDO).
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Con el pooler el usuario lleva la referencia del proyecto:
#   postgres.<ref>  o, con database/rol_aplicacion.sql,  dsi_app.<ref>
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASS=
DB_SCHEMA=inventario

# require = conexión cifrada obligatoria. Para validar además el
# certificado (recomendado), descargar el certificado CA desde
# Supabase → Database → Settings → SSL y poner su ruta aquí:
DB_SSLMODE=require
DB_SSLROOTCERT=
